# Dirección del contrato SubastaSimple desplegado en BSC Testnet
NEXT_PUBLIC_CONTRACT_ADDRESS=0x5fe9BaFC21E215C33B67F410cAc1c6bA7C8DF6d0

# Bloque de despliegue del contrato para filtrar eventos y cargar pujas más rápido.
# Si no sabes el bloque exacto, deja 0 (buscará desde el inicio de la red).
# Debe ser el BLOCK NUMBER (entero), no el block hash.
# Esto es más eficiente en términos de gas que simplemente almacenar un array de pujas en el contrato.
NEXT_PUBLIC_CONTRACT_DEPLOY_BLOCK=98910183

# RPC pública para leer historial de pujas (sin plan de pago)
NEXT_PUBLIC_EVENTS_RPC_URL=https://bsc-testnet.publicnode.com

NEXT_PUBLIC_FACTORY_ADDRESS=0x8896B6d7296bd79e3e8c0e63aA0739AD98bf52d0
# El bloque es para no tener que escanear toda la blockchain. Se escanea a partir de ese bloque.
NEXT_PUBLIC_FACTORY_DEPLOY_BLOCK=98920802 